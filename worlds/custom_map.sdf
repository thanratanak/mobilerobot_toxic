<?xml version="1.0" ?>
<!--
  Custom map for mobilerobot_toxic (10 x 8 m room with partitions and obstacles).

  NOTE: this file intentionally has NO <plugin> entries. gazebo_slam.launch.py
  injects the physics / sensors / IMU / scene-broadcaster systems with the
  right names for your Gazebo version (Fortress or Harmonic).

  To use your OWN map: pass  world:=/path/to/your_world.sdf  to the launch file.
-->
<sdf version="1.8">
  <world name="custom_map">
    <physics name="fast" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <gravity>0 0 -9.8</gravity>
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.8 0.85 0.9 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <surface>
            <friction><ode><mu>50</mu><mu2>50</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.85 0.85 0.85 1</ambient>
            <diffuse>0.85 0.85 0.85 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_north">
      <static>true</static>
      <pose>0 4 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>10.2 0.2 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>10.2 0.2 1.0</size></box></geometry>
          <material><ambient>0.55 0.55 0.6 1</ambient><diffuse>0.55 0.55 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static>
      <pose>0 -4 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>10.2 0.2 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>10.2 0.2 1.0</size></box></geometry>
          <material><ambient>0.55 0.55 0.6 1</ambient><diffuse>0.55 0.55 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static>
      <pose>5 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 8.2 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.2 8.2 1.0</size></box></geometry>
          <material><ambient>0.55 0.55 0.6 1</ambient><diffuse>0.55 0.55 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static>
      <pose>-5 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 8.2 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.2 8.2 1.0</size></box></geometry>
          <material><ambient>0.55 0.55 0.6 1</ambient><diffuse>0.55 0.55 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="partition_a">
      <static>true</static>
      <pose>-1.5 1.25 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 2.5 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.2 2.5 1.0</size></box></geometry>
          <material><ambient>0.45 0.55 0.6 1</ambient><diffuse>0.45 0.55 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="partition_b">
      <static>true</static>
      <pose>2.0 -1.25 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 2.5 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.2 2.5 1.0</size></box></geometry>
          <material><ambient>0.45 0.55 0.6 1</ambient><diffuse>0.45 0.55 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="crate">
      <static>true</static>
      <pose>3.0 2.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.8 0.8 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.8 0.8 1.0</size></box></geometry>
          <material><ambient>0.7 0.6 0.35 1</ambient><diffuse>0.7 0.6 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="barrel">
      <static>true</static>
      <pose>-3.0 -2.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.4</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.4</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.75 0.4 0.3 1</ambient><diffuse>0.75 0.4 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="pillar">
      <static>true</static>
      <pose>0.5 2.6 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.2</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.2</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.4 0.6 0.4 1</ambient><diffuse>0.4 0.6 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
